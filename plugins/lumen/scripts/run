#!/usr/bin/env bash
set -euo pipefail

# Determine the package root from the host-specific variables before falling
# back to the script location. Codex Agent Plugins inject PLUGIN_ROOT and a
# separate writable PLUGIN_DATA directory.
PACKAGE_ROOT="${CLAUDE_PLUGIN_ROOT:-${CURSOR_PLUGIN_ROOT:-${PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}}}"
BINARY_ROOT="${PLUGIN_DATA:-${PACKAGE_ROOT}}"

# Platform detection
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"
case "$ARCH" in
  x86_64)  ARCH="amd64" ;;
  aarch64) ARCH="arm64" ;;
esac

# Building from source needs a Go toolchain, the repo's go.mod and a readable
# manifest version. Git-based installs ship the source but no binary (bin/ is
# gitignored), and a bin/lumen carried over from an older revision must not be
# trusted, so a source build is stamped with the version it was built from.
BINARY=""
CAN_BUILD=0
SRC_VERSION=""
SRC_MANIFEST="${PACKAGE_ROOT}/.release-please-manifest.json"
if command -v go >/dev/null 2>&1 && [ -f "${PACKAGE_ROOT}/go.mod" ] && [ -f "$SRC_MANIFEST" ]; then
  SRC_VERSION="$(grep '"[.]"' "$SRC_MANIFEST" | sed 's/.*"[^"]*"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' || true)"
  if [ -n "$SRC_VERSION" ]; then CAN_BUILD=1; fi
fi
SOURCE_BINARY="${PACKAGE_ROOT}/bin/lumen"
SOURCE_STAMP="${PACKAGE_ROOT}/bin/lumen.source-version"

if [ "$CAN_BUILD" = 1 ] && [ -x "$SOURCE_BINARY" ] && [ "$(cat "$SOURCE_STAMP" 2>/dev/null || true)" = "$SRC_VERSION" ]; then
  BINARY="$SOURCE_BINARY"
fi

# The build goes to a temp file and is renamed into place, binary first and stamp
# second, so concurrent launches never exec a half-written binary or trust a stamp
# without its binary. Output goes to stderr: stdout is the MCP channel.
if [ -z "$BINARY" ] && [ "$CAN_BUILD" = 1 ]; then
  BUILD_TMP=""
  STAMP_TMP=""
  cleanup_build() { rm -f "$BUILD_TMP" "$STAMP_TMP"; }
  trap cleanup_build EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  echo "Building lumen ${SRC_VERSION} from source at ${PACKAGE_ROOT}..." >&2
  if mkdir -p "${PACKAGE_ROOT}/bin" \
    && BUILD_TMP="$(mktemp "${PACKAGE_ROOT}/bin/.lumen-build.XXXXXX")" \
    && (cd "${PACKAGE_ROOT}" && CGO_ENABLED=1 go build -tags=fts5 -buildvcs=false \
      -ldflags="-X github.com/ory/lumen/cmd.buildVersion=${SRC_VERSION}" -o "$BUILD_TMP" .) >&2 \
    && chmod +x "$BUILD_TMP" \
    && mv -f "$BUILD_TMP" "$SOURCE_BINARY"; then
    BUILD_TMP=""
    BINARY="$SOURCE_BINARY"
    if STAMP_TMP="$(mktemp "${PACKAGE_ROOT}/bin/.lumen-stamp.XXXXXX")" \
      && printf '%s\n' "$SRC_VERSION" > "$STAMP_TMP" \
      && mv -f "$STAMP_TMP" "$SOURCE_STAMP"; then
      STAMP_TMP=""
    fi
  else
    echo "Build from source failed; falling back to any existing binary or release download" >&2
  fi
  cleanup_build
  trap - EXIT INT TERM
fi

# Find binary: check bin/ first, then goreleaser dist/ output, then download
if [ -z "$BINARY" ]; then
  for candidate in \
    "${PACKAGE_ROOT}/bin/lumen" \
    "${PACKAGE_ROOT}/bin/lumen-${OS}-${ARCH}" \
    "${BINARY_ROOT}/bin/lumen-${OS}-${ARCH}"; do
    if [ -x "$candidate" ]; then
      BINARY="$candidate"
      break
    fi
  done
fi

# Download on first run if no binary found
if [ -z "$BINARY" ]; then
  BINARY="${BINARY_ROOT}/bin/lumen-${OS}-${ARCH}"

  REPO="ory/lumen"

  # The repository launcher reads release-please metadata. The isolated Codex
  # package carries the same version in its native plugin manifest.
  RELEASE_MANIFEST="${PACKAGE_ROOT}/.release-please-manifest.json"
  PLUGIN_MANIFEST="${PACKAGE_ROOT}/.codex-plugin/plugin.json"
  if [ -f "$RELEASE_MANIFEST" ]; then
    MANIFEST="$RELEASE_MANIFEST"
    VERSION="v$(grep '"[.]"' "$MANIFEST" | sed 's/.*"[^"]*"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
  elif [ -f "$PLUGIN_MANIFEST" ]; then
    MANIFEST="$PLUGIN_MANIFEST"
    VERSION="v$(grep '"version"' "$MANIFEST" | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/')"
  else
    echo "Error: no release or plugin manifest found in ${PACKAGE_ROOT}" >&2
    exit 1
  fi
  if [ -z "$VERSION" ] || [ "$VERSION" = "v" ]; then
    echo "Error: could not read version from ${MANIFEST}" >&2
    exit 1
  fi

  ASSET="lumen-${VERSION#v}-${OS}-${ARCH}"
  URL="https://github.com/${REPO}/releases/download/${VERSION}/${ASSET}"

  echo "Downloading lumen ${VERSION} for ${OS}/${ARCH}..." >&2
  mkdir -p "$(dirname "$BINARY")"

  if ! curl -fL --progress-bar --max-time 300 --retry 3 --retry-delay 2 "$URL" -o "$BINARY"; then
    # Fallback: manifest version not released yet — resolve latest from GitHub API
    echo "Version ${VERSION} not found, resolving latest release..." >&2

    AUTH_ARGS=()
    if [ -n "${GITHUB_TOKEN:-}" ]; then
      AUTH_ARGS=(-H "Authorization: token $GITHUB_TOKEN")
    fi

    LATEST_TAG=$(curl -sfL "${AUTH_ARGS[@]}" \
      --max-time 30 --retry 2 --retry-delay 2 \
      "https://api.github.com/repos/${REPO}/releases/latest" \
      | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

    if [ -z "$LATEST_TAG" ] || ! echo "$LATEST_TAG" | grep -qE '^v[0-9]'; then
      echo "Error: could not resolve latest release from GitHub API" >&2
      exit 1
    fi

    echo "Falling back to ${LATEST_TAG}..." >&2
    VERSION="$LATEST_TAG"
    ASSET="lumen-${VERSION#v}-${OS}-${ARCH}"
    URL="https://github.com/${REPO}/releases/download/${VERSION}/${ASSET}"

    curl -fL --progress-bar --max-time 300 --retry 3 --retry-delay 2 "$URL" -o "$BINARY"
  fi

  chmod +x "$BINARY"
  echo "Installed lumen to ${BINARY}" >&2
fi

exec "$BINARY" "$@"
